# Copy to .env.production and fill in values before deploy.
#   cp .env.production.example .env.production

# Required — generate with: openssl rand -base64 32
JWT_SECRET=

# Required — your public URL (no trailing slash). Use http://YOUR_VPS_IP:3000
# until you put HTTPS (Caddy/Nginx) in front, then switch to https://your.domain
ORIGIN=http://YOUR_VPS_IP:3000

# Optional — screenshot parsing
ANTHROPIC_API_KEY=

# Optional — host port mapped to container 3000
HOST_PORT=3000
